{
  "name": "opencode2api-bun",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Bun port of the opencode2api gateway (OpenCode Zen / Zen Go proxy)",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "build:binary": "bun build --compile --minify --sourcemap src/index.ts --outfile dist/opencode2api"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "22",
    "typescript": "^5.9.2"
  }
}